{
  "expo": {
    "name": "Choyeon Exercises",
    "slug": "ChoyeonExercises",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/play-store/icon-512.png",
    "userInterfaceStyle": "automatic",
    "scheme": "choyeon-exercises",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.choyeon.exercises"
    },
    "android": {
      "package": "com.choyeon.exercises",
      "adaptiveIcon": {
        "backgroundColor": "#0B0D12",
        "foregroundImage": "./assets/adaptive/ic_launcher_foreground.png",
        "backgroundImage": "./assets/adaptive/ic_launcher_background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
